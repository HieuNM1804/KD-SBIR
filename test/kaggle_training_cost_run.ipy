# ONE cell, shared by Colab online and Kaggle offline. Dataset must be present.
from pathlib import Path
import subprocess
import sys

DATA_ROOT = None  # Colab: set your extracted Sketchy folder if not auto-detected.
# Example: DATA_ROOT = "/content/drive/MyDrive/datasets/sketchy/Sketchy"
PROJECT = next((path for path in (
    Path.cwd(), Path("/content/KD-SBIR"), Path("/kaggle/working/KD-SBIR-encoder-cost")
) if (path / "src/benchmark_training_cost.py").is_file()), None)
if PROJECT is None:
    raise FileNotFoundError("Run Colab setup or Kaggle offline setup first.")
command = [sys.executable, "-m", "src.benchmark_training_cost",
    '--download-mode', 'auto',
    '--dataset', 'sketchy_2',
    '--epochs', '5',
    '--workers', '8',
    '--batch_size', '64',
    '--test_batch_size', '1024',
    '--n_ctx_visual', '3',
    '--prompt_depth', '12',
    '--teacher_pretrain_epochs', '1',
    '--teacher_pretrain_batch_size', '64',
    '--teacher_n_ctx_visual', '9',
    '--teacher_prompt_depth', '12',
    '--teacher_prompt_std', '0.02',
    '--teacher_prompt_lr', '0.03',
    '--teacher_prompt_seed', '42',
    '--teacher_prompt_gradient_checkpointing',
    '--teacher_momentum', '0.9',
    '--teacher_weight_decay', '0.001',
    '--lambda_teacher_retrieval', '1.5',
    '--teacher_triplet_margin', '0.3',
    '--lambda_domain', '2',
    '--lambda_modality', '2',
    '--kd_temperature', '0.07',
    '--photo_text_kd_temperature', '0.15',
    '--sketch_text_kd_temperature', '0.02',
    '--lr', '0.11',
    '--momentum', '0.95',
    '--weight_decay', '1e-4',
    '--seed', '42',
    '--exp_name', 'training_cost_sketchy2',
    '--progress',
]
if DATA_ROOT is not None:
    command.extend(["--root", str(DATA_ROOT)])
print("Project:", PROJECT, flush=True)
subprocess.run(command, cwd=PROJECT, check=True)
