"""Run matched Sketchy2 main and native Where+Effect, then export one ZIP.

The SGCD run keeps the validated teacher-only gate. If the gate fails, student
SGCD training is skipped and the ZIP contains the complete baseline and audit.
"""

import csv
import json
import os
import subprocess
import sys
import zipfile
from datetime import UTC, datetime
from pathlib import Path

PROJECT = Path("/kaggle/working/KD-SBIR-AVKD")
ROOT = "/kaggle/input/datasets/b20dccn616nguynhutun/sketchy/Sketchy"
TEACHER_CACHE = "/kaggle/working/teacher_cache/sketchy2_teacher_2ep.pt"
STAMP = datetime.now(UTC).strftime("%Y%m%d_%H%M%S_%f")
SGCD_CACHE = (
    "/kaggle/working/teacher_cache/"
    f"sketchy2_pcsgcd_pairwise_s42_k4_m10_rerun_{STAMP}.pt"
)
BASELINE_RUN = "main_baseline_sketchy2_s42_" + STAMP
AUDIT_RUN = "sgcd_audit_sketchy2_s42_" + STAMP
SGCD_RUN = "sgcd_native_where_effect_sketchy2_s42_" + STAMP
OUT = Path("/kaggle/working") / ("sgcd_sketchy2_comparison_" + STAMP)
OUT.mkdir(parents=True, exist_ok=False)
Path(TEACHER_CACHE).parent.mkdir(parents=True, exist_ok=True)


def run_stage(label, command):
    """Stream a subprocess to the notebook and retain its exact log."""
    log_path = OUT / f"{label}.log"
    print("=" * 80, flush=True)
    print(label.upper(), flush=True)
    print(" ".join(command), flush=True)
    print("=" * 80, flush=True)
    with log_path.open("w", encoding="utf-8") as log:
        process = subprocess.Popen(
            command,
            cwd=PROJECT,
            env=os.environ.copy(),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )
        assert process.stdout is not None
        for line in process.stdout:
            print(line.rstrip(), flush=True)
            log.write(line)
        code = process.wait()
    print(f"[{label}] exit code: {code}", flush=True)
    return code


def latest_version(run_name):
    versions = list((PROJECT / "tb_logs" / run_name).glob("version_*"))
    if not versions:
        return None
    return max(versions, key=lambda path: int(path.name.split("_")[-1]))


