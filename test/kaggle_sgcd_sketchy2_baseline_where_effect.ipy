audit_code = None
audit = None
audit_version = None
audit_path = None
sgcd_code = None
if baseline_code == 0:
    audit_command = [
        sys.executable,
        "-u",
        "-m",
        "src.train",
        *shared,
        *sgcd_arguments,
        "--sgcd_force_prepare",
        "--sgcd_audit_only",
        "--exp_name",
        AUDIT_RUN,
    ]
    audit_code = run_stage("sgcd_audit", audit_command)
    audit_version = latest_version(AUDIT_RUN)
    if audit_version is not None:
        candidate = audit_version / "sgcd_diagnostics" / "teacher_audit.json"
        if candidate.is_file():
            audit_path = candidate
            audit = json.loads(candidate.read_text(encoding="utf-8"))

    if audit_code == 0 and audit is not None and audit.get("passed"):
        sgcd_command = [
            sys.executable,
            "-u",
            "-m",
            "src.train",
            *shared,
            *sgcd_arguments,
            "--exp_name",
            SGCD_RUN,
        ]
        sgcd_code = run_stage("sgcd_where_effect", sgcd_command)
    else:
        (OUT / "sgcd_where_effect.log").write_text(
            "W+Effect was not started because the diagnostic audit did not pass.\n",
            encoding="utf-8",
        )
else:
    (OUT / "sgcd_audit.log").write_text(
        "Audit was not started because the matched baseline failed.\n",
        encoding="utf-8",
    )
    (OUT / "sgcd_where_effect.log").write_text(
        "SGCD was not started because the matched baseline failed.\n",
        encoding="utf-8",
    )


def read_scalars(version):
    from tensorboard.backend.event_processing.event_accumulator import (
        EventAccumulator,
    )

    accumulator = EventAccumulator(str(version), size_guidance={"scalars": 0})
    accumulator.Reload()
    return {
        tag: [
            {
                "step": value.step,
                "value": value.value,
                "wall_time": value.wall_time,
            }
            for value in accumulator.Scalars(tag)
        ]
        for tag in accumulator.Tags().get("scalars", [])
    }


def summarize_run(condition, run_name, return_code):
    version = latest_version(run_name)
    if version is None:
        return None, [], None
    metrics = read_scalars(version)
    map_values = metrics.get("mAP", [])
    precision_values = metrics.get("precision", [])
    curves = []
    for tag in sorted(metrics):
        for value in metrics[tag]:
            curves.append(
                {
                    "condition": condition,
                    "run": run_name,
                    "version": version.name,
                    "tag": tag,
                    **value,
                }
            )
    if not map_values or not precision_values:
        return None, curves, version
    map_by_step = {value["step"]: value["value"] for value in map_values}
    selected_index, selected_precision = max(
        enumerate(precision_values), key=lambda item: item[1]["value"]
    )
    selected_step = selected_precision["step"]
    if selected_step not in map_by_step:
        raise RuntimeError(
            f"mAP is missing at precision-selected step {selected_step}: {version}"
        )
    row = {
        "condition": condition,
        "run": run_name,
        "version": version.name,
        "return_code": return_code,
        "selected_validation_epoch": selected_index + 1,
        "selected_step": selected_step,
        "selected_mAP200": map_by_step[selected_step],
        "selected_P200": selected_precision["value"],
        "final_mAP200": map_values[-1]["value"],
        "final_P200": precision_values[-1]["value"],
        "best_mAP200": max(value["value"] for value in map_values),
        "best_P200": max(value["value"] for value in precision_values),
        "completed_validation_epochs": len(map_values),
    }
    return row, curves, version


def write_csv(path, rows, fieldnames=None):
    if not rows and fieldnames is None:
        return
    if fieldnames is None:
        fieldnames = list(rows[0])
    with path.open("w", newline="", encoding="utf-8") as stream:
        writer = csv.DictWriter(stream, fieldnames=fieldnames)
        writer.writeheader()
        writer.writerows(rows)


baseline_row, baseline_curves, baseline_version = summarize_run(
    "main", BASELINE_RUN, baseline_code
)
sgcd_row, sgcd_curves, sgcd_version = summarize_run(
    "native_where_effect", SGCD_RUN, sgcd_code
)
summary_rows = [row for row in (baseline_row, sgcd_row) if row is not None]
write_csv(OUT / "comparison_summary.csv", summary_rows)
write_csv(OUT / "scalar_curves.csv", baseline_curves + sgcd_curves)

delta_rows = []
if baseline_row is not None and sgcd_row is not None:
    delta_rows.append(
        {
            "baseline_run": BASELINE_RUN,
            "method_run": SGCD_RUN,
            "delta_selected_mAP200": sgcd_row["selected_mAP200"]
            - baseline_row["selected_mAP200"],
            "delta_selected_P200": sgcd_row["selected_P200"]
            - baseline_row["selected_P200"],
            "delta_final_mAP200": sgcd_row["final_mAP200"]
            - baseline_row["final_mAP200"],
            "delta_final_P200": sgcd_row["final_P200"] - baseline_row["final_P200"],
        }
    )
write_csv(
    OUT / "comparison_deltas.csv",
    delta_rows,
    fieldnames=(
        "baseline_run",
        "method_run",
        "delta_selected_mAP200",
        "delta_selected_P200",
        "delta_final_mAP200",
        "delta_final_P200",
    ),
)

# A successful training run repeats the audit without the diagnostic force flag.
# Prefer that strict report in the final manifest and visualizations.
if sgcd_version is not None:
    strict_audit = sgcd_version / "sgcd_diagnostics" / "teacher_audit.json"
    if strict_audit.is_file():
        audit_path = strict_audit
        audit = json.loads(strict_audit.read_text(encoding="utf-8"))

if baseline_code != 0:
    sgcd_status = "not_started_baseline_failed"
elif audit_code != 0 or audit is None:
    sgcd_status = "audit_failed_unexpectedly"
elif not audit.get("passed"):
    sgcd_status = "teacher_gate_failed"
elif sgcd_row is not None and sgcd_code == 0:
    sgcd_status = "trained"
else:
    sgcd_status = "failed"

source_commit = subprocess.check_output(
    ["git", "rev-parse", "HEAD"], cwd=PROJECT, text=True
).strip()
manifest = {
    "created": datetime.now(UTC).isoformat(),
    "source_commit": source_commit,
    "dataset": "sketchy_2",
    "metric": "mAP@200/P@200",
    "seed": 42,
    "baseline_run": BASELINE_RUN,
    "baseline_return_code": baseline_code,
    "audit_run": AUDIT_RUN,
    "audit_return_code": audit_code,
    "sgcd_run": SGCD_RUN,
    "sgcd_return_code": sgcd_code,
    "sgcd_status": sgcd_status,
    "audit_only_diagnostic_force_flag": True,
    "teacher_gate_bypassed_for_training": False,
    "claim_eligible": sgcd_status == "trained",
    "teacher_audit": audit,
    "notes": [
        "Baseline and W+Effect use the same teacher cache and main losses.",
        "The precision-selected checkpoint pairs mAP@200 and P@200 at one step.",
        "A failed teacher gate stops SGCD before target preparation and student training.",
        "No checkpoint or cache is copied into the diagnostics ZIP.",
    ],
}
(OUT / "manifest.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")

checkpoint_rows = []
for run_name in (BASELINE_RUN, SGCD_RUN):
    for checkpoint in sorted((PROJECT / "saved_models" / run_name).glob("*.ckpt")):
        checkpoint_rows.append(
            {
                "run": run_name,
                "checkpoint": checkpoint.name,
                "size_MiB": checkpoint.stat().st_size / 1024**2,
            }
        )
write_csv(OUT / "checkpoint_inventory.csv", checkpoint_rows)

if summary_rows:
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    names = [row["condition"] for row in summary_rows]
    fig, axes = plt.subplots(1, 2, figsize=(12, max(4, len(summary_rows) * 0.8)))
    axes[0].barh(
        range(len(summary_rows)),
        [100 * row["selected_mAP200"] for row in summary_rows],
    )
    axes[0].set_yticks(range(len(summary_rows)), names)
    axes[0].set_xlabel("mAP@200 at P@200-selected checkpoint (%)")
    axes[1].barh(
        range(len(summary_rows)),
        [100 * row["selected_P200"] for row in summary_rows],
    )
    axes[1].set_yticks(range(len(summary_rows)), [])
    axes[1].set_xlabel("Selected P@200 (%)")
    fig.tight_layout()
    fig.savefig(OUT / "comparison_selected.png", dpi=160)
    plt.close(fig)

archive = OUT.with_suffix(".zip")
with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as bundle:
    for path in sorted(OUT.rglob("*")):
        if path.is_file():
            bundle.write(path, Path("report") / path.relative_to(OUT))
    for run_name, version in (
        (BASELINE_RUN, baseline_version),
        (AUDIT_RUN, audit_version),
        (SGCD_RUN, sgcd_version),
    ):
        if version is None:
            continue
        diagnostic = version / "sgcd_diagnostics"
        if diagnostic.is_dir():
            for path in sorted(diagnostic.rglob("*")):
                if path.is_file():
                    bundle.write(
                        path,
                        Path("tb_logs")
                        / run_name
                        / version.name
                        / "sgcd_diagnostics"
                        / path.relative_to(diagnostic),
                    )

from IPython.display import FileLink, Image, display

comparison_plot = OUT / "comparison_selected.png"
if comparison_plot.is_file():
    display(Image(filename=str(comparison_plot)))
if audit_path is not None:
    for name in ("teacher_audit.png", "teacher_audit_examples.png"):
        image = audit_path.parent / name
        if image.is_file():
            display(Image(filename=str(image)))

print("Sketchy2 SGCD status:", sgcd_status)
print("Send this ZIP:", archive)
display(FileLink(str(archive)))

if baseline_code != 0:
    raise RuntimeError("Matched Sketchy2 baseline failed; inspect baseline.log in ZIP.")
if sgcd_status in {"failed", "audit_failed_unexpectedly"}:
    raise RuntimeError("Sketchy2 W+Effect failed unexpectedly; inspect ZIP logs.")
if sgcd_status == "teacher_gate_failed":
    print(
        "Teacher gate failed, so W+Effect student training was correctly skipped. "
        "Use the ZIP audit to decide whether the Sketchy2 target must be redesigned."
    )
